[Unit]
Description=Quatrro VLM Extraction Service
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/quatrro
Environment="PATH=/home/ubuntu/quatrro/venv/bin"
EnvironmentFile=/home/ubuntu/quatrro/.env
ExecStart=/home/ubuntu/quatrro/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000

# Restart on failure
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
